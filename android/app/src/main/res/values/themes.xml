<resources>
    <!-- Base application theme -->
    <style name="Theme.MadSol" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary_emerald</item>
        <item name="colorPrimaryVariant">@color/primary_emerald_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/accent_emerald_light</item>
        <item name="colorSecondaryVariant">@color/primary_emerald</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/primary_emerald_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Window background -->
        <item name="android:windowBackground">@color/primary_emerald_dark</item>
    </style>
</resources>
